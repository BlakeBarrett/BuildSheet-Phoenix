# ── AI Provider ──────────────────────────────────────────────────────────────
# 'hosted'       — Cloud AI SDK (requires an API key)
# 'openai-compat' — Any OpenAI-compatible REST endpoint: OpenAI, Alibaba Cloud
#                   (Qwen via DashScope), Mistral, local Ollama, etc.
#                   ('on-prem' is accepted as a legacy alias for 'openai-compat')
# For Qwen / Alibaba Cloud DashScope:
#   AI_PROVIDER=openai-compat
#   AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_PROVIDER=
# Base URL for OpenAI-compatible providers (e.g. https://api.openai.com/v1)
AI_BASE_URL=
# Base URL for image generation API (e.g. DashScope)
AI_IMAGE_BASE_URL=
# Display name shown in the UI for the AI service
AI_DISPLAY_NAME=

# ── Model Selection ──────────────────────────────────────────────────────────
# Leave blank to use provider defaults
AI_MODEL_FAST=
AI_MODEL_SMART=
AI_MODEL_STRUCTURED=
AI_MODEL_IMAGE=
AI_MODEL_AUDIO=

# ── API Keys ─────────────────────────────────────────────────────────────────
# Primary AI key (consumed by the backend server — never sent to the browser)
AI_KEY=
# Optional: separate key for search/grounding operations
SEARCH_API_KEY=

# ── Firebase (client-side auth & Firestore) ──────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Stripe Billing ───────────────────────────────────────────────────────────
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=
VITE_STRIPE_PRO_ANNUAL_PRICE_ID=

# ── reCAPTCHA (App Check) ───────────────────────────────────────────────────
VITE_RECAPTCHA_SITE_KEY=

# ── Procurement Pipeline (server-side) ───────────────────────────────────────
# SearXNG instance for part discovery
SEARXNG_BASE_URL=http://localhost:8888
# Firecrawl instance for web page extraction
FIRECRAWL_BASE_URL=http://localhost:3002
FIRECRAWL_API_KEY=